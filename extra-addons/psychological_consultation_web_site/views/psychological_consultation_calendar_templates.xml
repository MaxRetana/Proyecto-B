<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="consultations_selector_home_page" name="Inicio del Consultorio">
        <t t-call="website.layout">
            <div id="wrap" class="pc-calendar-wrap pc-home-wrap">
                <section class="pc-calendar-hero pc-home-hero">
                    <div class="container">
                        <p class="pc-home-kicker">Consultorio Psicologico</p>
                        <h1>Elige como quieres continuar</h1>
                        <p>Selecciona una opcion para solicitar nuevas consultas o revisar el calendario de citas confirmadas.</p>
                    </div>
                </section>

                <section class="pc-calendar-content">
                    <div class="container">
                        <div class="pc-home-grid">
                            <article class="pc-home-card">
                                <div class="pc-home-card-icon" aria-hidden="true">&#128221;</div>
                                <h2>Consultas</h2>
                                <p>Registra una nueva solicitud y asigna paciente cuando corresponda.</p>
                                <a href="/psychological/consultations/request" class="btn btn-primary">Ir al formulario</a>
                            </article>

                            <article class="pc-home-card pc-home-card-alt">
                                <div class="pc-home-card-icon" aria-hidden="true">&#128197;</div>
                                <h2>Calendario</h2>
                                <p>Consulta citas confirmadas y realizadas en vista mensual interactiva.</p>
                                <a href="/psychological/consultations/calendar" class="btn btn-outline-secondary">Ver calendario</a>
                            </article>
                        </div>

                        <t t-if="is_public">
                            <div class="alert alert-info mt-4 mb-0" role="alert">
                                Inicia sesion para crear consultas o revisar tus eventos.
                                <a href="/web/login?redirect=/" class="btn btn-sm btn-primary ms-2">Iniciar sesion</a>
                            </div>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="consultations_home_page" name="Inicio Consultas Psicológicas">
        <t t-call="website.layout">
            <div id="wrap" class="pc-calendar-wrap">
                <section class="pc-calendar-hero">
                    <div class="container">
                        <h1>Bienvenido al Consultorio</h1>
                        <p>Solicita tu consulta en linea. Tu solicitud quedara en borrador hasta ser confirmada por el equipo.</p>
                    </div>
                </section>

                <section class="pc-calendar-content">
                    <div class="container">
                        <div class="pc-calendar-panel">
                            <t t-if="is_public">
                                <div class="alert alert-info mb-3" role="alert">
                                    Debes iniciar sesion como usuario portal para solicitar una consulta.
                                    <a href="/web/login" class="btn btn-sm btn-primary ms-2">Iniciar sesion</a>
                                </div>
                            </t>

                            <t t-if="error_message">
                                <div class="alert alert-danger" role="alert">
                                    <t t-esc="error_message"/>
                                </div>
                            </t>

                            <t t-if="success_message">
                                <div class="alert alert-success" role="alert">
                                    <t t-esc="success_message"/>
                                </div>
                            </t>

                            <t t-if="is_portal or is_admin or is_capturista or is_psychologist">
                                <h2 class="pc-current-month">Solicitar Consulta</h2>
                                <form action="/psychological/consultations/request" method="post" class="pc-request-form mt-3">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <t t-if="show_patient_selector">
                                        <div class="mb-3">
                                            <label class="form-label" for="pacient_id">Paciente</label>
                                            <select id="pacient_id" name="pacient_id" class="form-control" required="required">
                                                <option value="">Selecciona un paciente</option>
                                                <t t-foreach="patients" t-as="patient">
                                                    <option t-att-value="patient.id" t-att-selected="patient.id == int(form_data.get('pacient_id') or 0)">
                                                        <t t-esc="patient.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                            <small class="text-muted">Selecciona el paciente para crear la consulta desde recepción o agenda.</small>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <input type="hidden" name="pacient_id" t-att-value="form_data.get('pacient_id')"/>
                                    </t>

                                    <div class="mb-3">
                                        <label class="form-label" for="request_date">Fecha de consulta</label>
                                        <input
                                            id="request_date"
                                            type="date"
                                            name="request_date"
                                            class="form-control"
                                            required="required"
                                            t-att-value="form_data.get('request_date')"
                                        />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="request_time">Hora disponible</label>
                                        <select id="request_time" name="request_time" class="form-control" required="required" t-att-data-selected="form_data.get('request_time') or ''">
                                            <option value="">Selecciona primero una fecha</option>
                                        </select>
                                        <small id="request_time_help" class="text-muted">Las horas se cargan segun time.work.consultation.</small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="notes">Motivo o notas</label>
                                        <textarea
                                            id="notes"
                                            name="notes"
                                            class="form-control"
                                            rows="4"
                                            placeholder="Escribe una breve descripcion de tu solicitud"
                                        ><t t-esc="form_data.get('notes')"/></textarea>
                                    </div>

                                    <div class="d-flex gap-2 flex-wrap">
                                        <button type="submit" class="btn btn-primary">Enviar solicitud</button>
                                        <a href="/" class="btn btn-light">Volver al inicio</a>
                                        <a href="/psychological/consultations/calendar" class="btn btn-outline-secondary">Ver calendario confirmado</a>
                                    </div>
                                </form>
                            </t>

                            <t t-if="not is_portal and not is_admin and not is_capturista and not is_psychologist and not is_public">
                                <div class="alert alert-warning" role="alert">
                                    Esta pagina de solicitud esta destinada a usuarios portal o personal autorizado.
                                </div>
                                <a href="/psychological/consultations/calendar" class="btn btn-outline-secondary">Ir al calendario</a>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="consultations_calendar_page" name="Calendario de Consultas Psicológicas">
        <t t-call="website.layout">
            <div id="wrap" class="pc-calendar-wrap">
                <section class="pc-calendar-hero">
                    <div class="container">
                        <h1>Calendario de Consultas</h1>
                        <p>Visualiza las consultas confirmadas y realizadas en un calendario mensual.</p>
                    </div>
                </section>

                <section class="pc-calendar-content">
                    <div class="container">
                        <div class="pc-calendar-panel">
                            <div class="pc-calendar-toolbar">
                                <button type="button" class="pc-nav-btn" data-action="prev">Mes anterior</button>
                                <h2 id="pc-current-month" class="pc-current-month">Cargando calendario...</h2>
                                <button type="button" class="pc-nav-btn" data-action="next">Mes siguiente</button>
                            </div>

                            <div class="pc-legend">
                                <span class="pc-legend-item pc-state-confirmed">Confirmada</span>
                                <span class="pc-legend-item pc-state-done">Realizada</span>
                            </div>

                            <div id="pc-calendar-grid" class="pc-calendar-grid" aria-live="polite"></div>

                            <div id="pc-event-modal" class="modal fade" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-sm modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header py-2">
                                            <h5 class="modal-title mb-0" id="pc-event-modal-title">Detalle de consulta</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                        </div>
                                        <div class="modal-body py-3">
                                            <div class="small text-muted mb-2" id="pc-event-modal-reference"></div>
                                            <div class="mb-2"><strong>Fecha:</strong> <span id="pc-event-modal-date"></span></div>
                                            <div class="mb-2"><strong>Estado:</strong> <span id="pc-event-modal-state"></span></div>
                                            <div class="mb-2"><strong>Paciente:</strong> <span id="pc-event-modal-patient"></span></div>
                                            <div class="mb-2"><strong>Psicólogo:</strong> <span id="pc-event-modal-psychologist"></span></div>
                                            <div class="mb-0"><strong>Notas:</strong><br/><span id="pc-event-modal-notes"></span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="menu_psychological_consultation_calendar" model="website.menu">
        <field name="name">Calendario de Consultas</field>
        <field name="url">/psychological/consultations/calendar</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">80</field>
    </record>

    <!-- Ocultar visualmente elementos no deseados (Contacto, Buscador, Teléfono) -->
    <template id="hide_website_elements" inherit_id="website.layout" name="Hide Website Elements">
        <xpath expr="." position="inside">
            <style>
                /* Oculta el enlace en menús, botones y pie de página */
                a[href="/contactus"], 
                .nav-link[href="/contactus"],
                [data-reference="website.menu_contactus"],
                /* Oculta el buscador y sus iconos */
                .oi-search,
                .o_search_button,
                [data-bs-target="#o_search_modal"],
                .o_searchbar_container,
                .website_search_box,
                .o_wsale_products_searchbar_form,
                a[href="/website/search"],
                /* Oculta el número de teléfono/contacto */
                [href^="tel:"],
                .js_header_contact {
                    display: none !important;
                }
            </style>
        </xpath>
    </template>

    <!-- Deshabilitar el menú de 'Contáctanos' del sitio web -->
    <record id="website.menu_contactus" model="website.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
