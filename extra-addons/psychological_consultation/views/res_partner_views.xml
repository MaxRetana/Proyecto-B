<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pacient_psychological_consultation_view_form" model="ir.ui.view">
        <field name="name">pacient_psychological_consultation_view_form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Paciente">
                <sheet>
                    <group>
                        <group name="general_information" string="Información General">
                            <field name="name"/>
                        </group>
                        <group name="configuration" string="Configuración" invisible="1">
                            <field name="type_of_psychologist_consultation"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page name="contact_info" string="Contacto">
                            <group>
                                <field name="email"/>
                                <field name="phone"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pacient_psychological_consultation_view_list" model="ir.ui.view">
        <field name="name">pacient_psychological_consultation_view_list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Pacientes">
                <field name="name"/>
                <field name="type_of_psychologist_consultation" optional="hide"/>
                <field name="email" />
                <field name="phone" />
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="pacient_psychological_consultation_view_search" model="ir.ui.view">
        <field name="name">pacient_psychological_consultation_view_search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar Pacientes">
                <field name="name" string="Nombre"/>
                <field name="email" string="Email"/>
                <field name="phone" string="Teléfono"/>
            </search>
        </field>
    </record>

    <!-- Accion  de Paciente -->
    <record id="action_psychological_consultation_pacient" model="ir.actions.act_window">
        <field name="name">Pacientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="views_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('pacient_psychological_consultation_view_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('pacient_psychological_consultation_view_form')})]"/>
        <field name="search_view_id" ref="pacient_psychological_consultation_view_search"/>
        <field name="domain">[('is_psychologist_consultation', '=', True), ('type_of_psychologist_consultation', '=', 'patient')]</field>
        <field name="context">{'default_is_psychologist_consultation': True, 'default_type_of_psychologist_consultation': 'patient'}</field>
    </record>

    <record id="psychologist_psychological_consultation_view_form" model="ir.ui.view">
        <field name="name">psychologist_psychological_consultation_view_form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Psicólogo">
                <sheet>
                    <group>
                        <group name="general_information" string="Información General">
                            <field name="name"/>
                        </group>
                        <group name="configuration" string="Configuración" invisible="1">
                            <field name="type_of_psychologist_consultation"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page name="contact_info" string="Contacto">
                            <group>
                                <field name="email"/>
                                <field name="phone"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="psychologist_psychological_consultation_view_list" model="ir.ui.view">
        <field name="name">psychologist_psychological_consultation_view_list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Psicólogos">
                <field name="name"/>
                <field name="type_of_psychologist_consultation" optional="hide"/>
                <field name="email" />
                <field name="phone" />
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="psychologist_psychological_consultation_view_search" model="ir.ui.view">
        <field name="name">psychologist_psychological_consultation_view_search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml"></field>
            <search string="Buscar Psicólogos">
                <field name="name" string="Nombre"/>
                <field name="email" string="Email"/>
                <field name="phone" string="Teléfono"/>
            </search>
        </field>
    </record>

    <!-- Accion  de Psicólogo -->
    <record id="action_psychological_consultation_psychologist" model="ir.actions.act_window">
        <field name="name">Psicólogos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="views_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('psychologist_psychological_consultation_view_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('psychologist_psychological_consultation_view_form')})]"/>
        <field name="search_view_id" ref="psychologist_psychological_consultation_view_search"/>
        <field name="domain">[('is_psychologist_consultation', '=', True), ('type_of_psychologist_consultation', '=', 'psychologist')]</field>
        <field name="context">{'default_is_psychologist_consultation': True, 'default_type_of_psychologist_consultation': 'psychologist'}</field>
    </record>


</odoo>