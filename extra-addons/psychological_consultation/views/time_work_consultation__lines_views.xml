<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View time.work.consultation.line View List -->
    <record id="view_time_work_consultation_line_list" model="ir.ui.view">
        <field name="name">view.time.work.consultation.line.list</field>
        <field name="model">time.work.consultation.line</field>
        <field name="arch" type="xml">
            <list string="Horarios">
                <field name="consultation_id" />
                <field name="day_of_week"/>
                <field name="start_time"/>
                <field name="end_time"/>
            </list>
        </field>
    </record>

    <!-- View time.work.consultation.line form -->
    <record id="view_time_work_consultation_line_form" model="ir.ui.view">
        <field name="name">view.time.work.consultation.line.form</field>
        <field name="model">time.work.consultation.line</field>
        <field name="arch" type="xml">
            <form string="Horario">
                <sheet>
                    <field name="consultation_id" />
                    <field name="day_of_week"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View time.work.consultation.line search -->
    <record id="view_time_work_consultation_line_search" model="ir.ui.view">
        <field name="name">view.time.work.consultation.line.search</field>
        <field name="model">time.work.consultation.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="consultation_id"/>
                <separator/>
                <filter string="Agrupar por consulta" name="group_consultation" context="{'group_by': 'consultation_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action time.work.consultation.line -->
    <record id="action_time_work_consultation_line" model="ir.actions.act_window">
        <field name="name">Horarios de Trabajo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">time.work.consultation.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay horarios de trabajo definidos. Haz clic aquí para crear uno nuevo.
            </p>
        </field>
    </record>

    <!-- Menu time.work.consultation.line -->
    <menuitem
        id="menu_time_work_consultation_line"
        name="Horarios de Trabajo Líneas"
        parent="menu_time_work_consultation_root"
        action="action_time_work_consultation_line"
        sequence="20"/>

</odoo>
