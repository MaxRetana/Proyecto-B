<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View psychological.consultation.cancelation form -->
    <record id="view_psychological_consultation_cancelation_form" model="ir.ui.view">
        <field name="name">view.psychological.consultation.cancelation.form</field>
        <field name="model">psychological.consultation.cancelation</field>
        <field name="arch" type="xml">
            <form string="Psychological Consultation Cancelation">
                <sheet>
                    <div class="oe_title">
                        <label for="reason"/>
                        <h1>
                            <field name="reason" placeholder="Ingrese la razón de la cancelación..."/>
                        </h1>
                    </div>
                </sheet>
                <footer>
                    <button name="action_cancel_consultation" string="Cancelar" type="object" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
